<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.reven.project.service.co.mapper.COAdminMapper">

    <sql id="adminSearchWhere">
        where 1 = 1
          and reg_dtm &gt;= #{dateFrom}
          and reg_dtm &lt; date_add(#{dateTo}, interval 1 day)
        <if test="keyword != null and keyword != ''">
            <choose>
                <when test="keywordType == 'name'">
                    and name like concat('%', #{keyword}, '%')
                </when>
                <when test="keywordType == 'login_id'">
                    and login_id like concat('%', #{keyword}, '%')
                </when>
                <otherwise>
                    and (
                        name like concat('%', #{keyword}, '%')
                        or login_id like concat('%', #{keyword}, '%')
                    )
                </otherwise>
            </choose>
        </if>
    </sql>

    <resultMap id="COAdminSessionResultMap" type="com.reven.project.service.co.dto.COAdminSessionDto">
        <constructor>
            <idArg column="adm_seq" javaType="java.lang.Long"/>
            <arg column="login_id" javaType="java.lang.String"/>
            <arg column="password_hash" javaType="java.lang.String"/>
            <arg column="name" javaType="java.lang.String"/>
            <arg column="role_csv" javaType="java.lang.String"/>
            <arg column="last_login_at" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <resultMap id="COAdminDetailResultMap" type="com.reven.project.service.co.dto.COAdminDetailResponseDto">
        <constructor>
            <idArg column="adm_seq" javaType="java.lang.Long"/>
            <arg column="login_id" javaType="java.lang.String"/>
            <arg column="name" javaType="java.lang.String"/>
            <arg column="role" javaType="java.lang.String"/>
            <arg column="status" javaType="java.lang.String"/>
            <arg column="password_hash" javaType="java.lang.String"/>
            <arg column="reg_dtm" javaType="java.time.LocalDateTime"/>
            <arg column="reg_id" javaType="java.lang.String"/>
            <arg column="mod_dtm" javaType="java.time.LocalDateTime"/>
            <arg column="mod_id" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <select id="selectAdminByLoginId" resultMap="COAdminSessionResultMap">
        select
            adm_seq,
            login_id,
            password_hash,
            name,
            coalesce(role, 'ADMIN') as role_csv,
            null as last_login_at
        from co_adm_mst
        where login_id = #{loginId}
          and status = 'active'
    </select>

    <select id="selectAdminByLoginIdAnyStatus" resultMap="COAdminSessionResultMap">
        select
            adm_seq,
            login_id,
            password_hash,
            name,
            coalesce(role, 'ADMIN') as role_csv,
            null as last_login_at
        from co_adm_mst
        where login_id = #{loginId}
        limit 1
    </select>

    <select id="selectAdminBySeq" resultMap="COAdminDetailResultMap">
        select
            adm_seq,
            login_id,
            name,
            role,
            status,
            password_hash,
            reg_dtm,
            reg_id,
            mod_dtm,
            mod_id
        from co_adm_mst
        where adm_seq = #{adminSeq}
        limit 1
    </select>

    <select id="countAdmins" resultType="long">
        select count(*)
        from co_adm_mst
        <include refid="adminSearchWhere"/>
    </select>

    <select id="selectAdmins" resultType="com.reven.project.service.co.dto.COAdminListItemResponseDto">
        select
            adm_seq as adminSeq,
            login_id as loginId,
            name,
            role,
            status,
            date(reg_dtm) as registeredDate,
            date(mod_dtm) as updatedDate
        from co_adm_mst
        <include refid="adminSearchWhere"/>
        order by reg_dtm desc, adm_seq desc
    </select>

    <insert id="insertAdmin" parameterType="com.reven.project.service.co.dto.COAdminDetailResponseDto">
        insert into co_adm_mst (
            login_id,
            name,
            role,
            status,
            password_hash,
            reg_dtm,
            reg_id,
            mod_dtm,
            mod_id
        ) values (
            #{loginId},
            #{name},
            #{role},
            #{status},
            #{passwordHash},
            #{regDtm},
            #{regId},
            #{modDtm},
            #{modId}
        )
    </insert>

    <update id="updateAdmin" parameterType="com.reven.project.service.co.dto.COAdminDetailResponseDto">
        update co_adm_mst
        set name = #{name},
            status = #{status},
            password_hash = #{passwordHash},
            mod_dtm = #{modDtm},
            mod_id = #{modId}
        where adm_seq = #{adminSeq}
    </update>

    <delete id="deleteAdmin">
        delete from co_adm_mst
        where adm_seq = #{adminSeq}
    </delete>
</mapper>
